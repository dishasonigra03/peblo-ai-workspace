# PostgreSQL database connection (or SQLite fallback: sqlite:///./backend/peblo.db)
DATABASE_URL=postgresql://user:password@localhost:5432/peblo_db

# Secret token signing key
JWT_SECRET=your_super_secret_jwt_sign_key_here

# Google Gemini API credential token (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
